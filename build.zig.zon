// SPDX-License-Identifier: curl
// See FORK-LICENSE.md for what that identifier covers.
.{
    // Package, module, and artifact use the same name.
    .name = .libcurl,
    // Release version from include/curl/curlver.h:35; the shared-library ABI version is separate.
    .version = "8.22.0",
    .fingerprint = 0x3fd74701c77f15de,
    .minimum_zig_version = "0.16.0",
    // The required TLS backend; this package has no TLS-disabled build.
    .dependencies = .{
        .@"mbed-tls" = .{ .path = "../mbed-tls" },
    },
    .paths = .{
        // Build graph and target-derived config generator.
        "build.zig",
        "build.zig.zon",
        "build_support",
        // Zig facade and aggregate translation header.
        "zig",
        // Unmodified upstream source and public headers.
        "lib",
        "include",
        // Runtime-loading support used by the published module.
        "runtime",
        // Tests, example, and separate consumer package.
        "tests.zig",
        "smoke.zig",
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream licence and release records.
        "COPYING",
        "README",
        "RELEASE-NOTES",
        // Provenance and licence records.
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "NOTICE.md",
        "FORK-LICENSE.md",
        // Package documentation.
        "README.md",
        "README.zig.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        // Provenance verifier.
        "tools",
        // Nix and devenv packaging.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
        // Cross-test harness profile.
        "cross-test.profile.sh",
        // Build outputs, locks, and developer state are excluded.
    },
}
